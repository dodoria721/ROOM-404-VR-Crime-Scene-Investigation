  m_text: "\uD53C\uD574\uC790 \uC815\uD558\uB9B0\uC740 \uC5F0\uAD6C\uC2E4\uC5D0\uC11C
    \uC774\uC11C\uC5F0\uACFC \uB300\uBA74\uD55C \uB4A4 \uBAB8\uC2F8\uC6C0 \uACFC\uC815\uC5D0\uC11C
    \uCC45\uC0C1 \uBAA8\uC11C\uB9AC\uC5D0 \uCDA9\uB3CC\uD588\uC2B5\uB2C8\uB2E4.\n\n\uC774\uC11C\uC5F0\uC740
